    e2 -->|"span id"| p5
    d1 -->|"record offset and content path"| p5
    d3 -->|"metadata only flag, size limit"| p5
    e1 -->|"raw record text"| p5
    p5 -->|"redacted text or refusal"| e2

    subgraph Legend
        direction LR
        zlegend_a("1.0 Process"):::proc
