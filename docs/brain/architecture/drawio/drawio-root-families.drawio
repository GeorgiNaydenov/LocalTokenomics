<mxfile host="product-brain" version="1"><diagram name="page-1" id="p1"><mxGraphModel grid="0" page="1" pageWidth="1400" pageHeight="900" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f1" value="Package and install" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#222222;fontColor=#222222;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="330" height="348" as="geometry"/></mxCell><mxCell id="c1" value="Install the ai-usage-cost console command&#10;Access: anyone who installs the package" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#222222;fontColor=#142233;fontSize=11;" vertex="1" parent="f1"><mxGeometry x="20" y="44" width="290" height="84" as="geometry"/></mxCell><mxCell id="c2" value="Choose optional extras: png, sql, alert, tui&#10;Access: anyone who installs the package" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#222222;fontColor=#142233;fontSize=11;" vertex="1" parent="f1"><mxGeometry x="20" y="144" width="290" height="84" as="geometry"/></mxCell><mxCell id="c3" value="Ship the built dashboard inside the wheel&#10;Run by: the maintainer building a release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#222222;fontColor=#331a00;fontSize=11;" vertex="1" parent="f1"><mxGeometry x="20" y="244" width="290" height="84" as="geometry"/></mxCell><mxCell id="f2" value="Dashboard build and development" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#222222;fontColor=#222222;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="20" width="330" height="348" as="geometry"/></mxCell><mxCell id="c4" value="Build the dashboard into the Python package&#10;Run by: the maintainer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#222222;fontColor=#331a00;fontSize=11;" vertex="1" parent="f2"><mxGeometry x="20" y="44" width="290" height="84" as="geometry"/></mxCell><mxCell id="c5" value="Edit with hot reload against live data (API proxy)&#10;Run by: the maintainer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#222222;fontColor=#331a00;fontSize=11;" vertex="1" parent="f2"><mxGeometry x="20" y="144" width="290" height="84" as="geometry"/></mxCell><mxCell id="c6" value="Run component tests in a simulated browser&#10;Run by: the maintainer or a pull request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#222222;fontColor=#331a00;fontSize=11;" vertex="1" parent="f2"><mxGeometry x="20" y="244" width="290" height="84" as="geometry"/></mxCell><mxCell id="f3" value="Code quality gates" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#222222;fontColor=#222222;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="20" width="330" height="648" as="geometry"/></mxCell><mxCell id="c7" value="Lint and format Python (ruff)&#10;Run by: the maintainer, a hook or a pull request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#222222;fontColor=#331a00;fontSize=11;" vertex="1" parent="f3"><mxGeometry x="20" y="44" width="290" height="84" as="geometry"/></mxCell><mxCell id="c8" value="Type check Python (mypy) and the dashboard (tsc strict)&#10;Run by: the maintainer or a pull request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#222222;fontColor=#331a00;fontSize=11;" vertex="1" parent="f3"><mxGeometry x="20" y="144" width="290" height="84" as="geometry"/></mxCell><mxCell id="c9" value="Score Python with pylint, at least 9.0&#10;Run by: a hook or a pull request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#222222;fontColor=#331a00;fontSize=11;" vertex="1" parent="f3"><mxGeometry x="20" y="244" width="290" height="84" as="geometry"/></mxCell><mxCell id="c10" value="Lint the dashboard (ESLint)&#10;Run by: a hook or a pull request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#222222;fontColor=#331a00;fontSize=11;" vertex="1" parent="f3"><mxGeometry x="20" y="344" width="290" height="84" as="geometry"/></mxCell><mxCell id="c11" value="Run checks before each commit (pre-commit)&#10;Run by: the committer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#222222;fontColor=#331a00;fontSize=11;" vertex="1" parent="f3"><mxGeometry x="20" y="444" width="290" height="84" as="geometry"/></mxCell><mxCell id="c12" value="Security lint (bandit) is configured, no check runs it&#10;Run by: nobody found" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#222222;dashed=1;fontColor=#331a00;fontSize=11;" vertex="1" parent="f3"><mxGeometry x="20" y="544" width="290" height="84" as="geometry"/></mxCell><mxCell id="f4" value="Delivery checks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#222222;fontColor=#222222;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1070" y="20" width="330" height="348" as="geometry"/></mxCell><mxCell id="c13" value="Test Python on 2 systems and 3 versions&#10;Run by: a pull request or a push to main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#222222;fontColor=#331a00;fontSize=11;" vertex="1" parent="f4"><mxGeometry x="20" y="44" width="290" height="84" as="geometry"/></mxCell><mxCell id="c14" value="Lint, type check, test and build the dashboard&#10;Run by: a pull request or a push to main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#222222;fontColor=#331a00;fontSize=11;" vertex="1" parent="f4"><mxGeometry x="20" y="144" width="290" height="84" as="geometry"/></mxCell><mxCell id="c15" value="Scan Python and TypeScript with CodeQL&#10;Run by: a pull request, a push or a weekly schedule" style="rounded=1;whiteSpace=