<mxfile host="product-brain" version="1"><diagram name="page-1" id="p1"><mxGraphModel grid="0" page="1" pageWidth="1050" pageHeight="560" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Session card wireframe" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#222222;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="card" value="SessionCard: bordered card with hover highlight" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;fontColor=#222222;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="520" height="430" as="geometry"/></mxCell>
<mxCell id="open" value="button: Open session (covers the whole card, no visible label)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#222222;fontColor=#222222;fontSize=12;" vertex="1" parent="card"><mxGeometry x="20" y="30" width="480" height="40" as="geometry"/></mxCell>
<mxCell id="head" value="Header row: state dot and label, traced dot, session id at the right" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;fontColor=#222222;fontSize=12;" vertex="1" parent="card"><mxGeometry x="20" y="80" width="480" height="40" as="geometry"/></mxCell>
<mxCell id="outc" value="Outcome row: outcome badge and error count" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#b46504;fontColor=#222222;fontSize=12;" vertex="1" parent="card"><mxGeometry x="20" y="130" width="480" height="40" as="geometry"/></mxCell>
<mxCell id="model" value="Model name, and +N when more models were used" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#b46504;fontColor=#222222;fontSize=12;" vertex="1" parent="card"><mxGeometry x="20" y="180" width="480" height="40" as="geometry"/></mxCell>
<mxCell id="who" value="Client on the left, project on the right" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;fontColor=#222222;fontSize=12;" vertex="1" parent="card"><mxGeometry x="20" y="230" width="480" height="40" as="geometry"/></mxCell>
<mxCell id="when" value="Start time on the left, request count on the right" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;fontColor=#222222;fontSize=12;" vertex="1" parent="card"><mxGeometry x="20" y="280" width="480" height="40" as="geometry"/></mxCell>
<mxCell id="money" value="Tokens on the left, cost on the right, unavailable when null" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;fontColor=#222222;fontSize=12;" vertex="1" parent="card"><mxGeometry x="20" y="330" width="480" height="40" as="geometry"/></mxCell>
<mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Outer box: the card component&lt;br&gt;Blue box: button, here an invisible overlay over the card&lt;br&gt;White box: a row of text or values&lt;br&gt;Dashed amber box: row drawn only when its prop is given&lt;br&gt;Rows follow the order of the markup, top to bottom" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#222222;fontColor=#222222;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="70" width="380" height="170" as="geometry"/></mxCell>
